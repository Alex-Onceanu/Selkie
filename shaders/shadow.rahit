#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_debug_printf : enable

#include "util.glsl"

hitAttributeEXT hitInfo_t hitInfo;

layout(location = 1) rayPayloadInEXT shadowPayload_t payload;

void main()
{
    payload.shadow = min(payload.shadow, hitInfo.shadow);
    if(gl_HitKindEXT != 0U) ignoreIntersectionEXT;
}