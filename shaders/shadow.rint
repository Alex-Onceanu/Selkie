#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_debug_printf : enable

#include "constants.glsl"
#include "ssbo.glsl"
#include "sdfs.glsl"

hitAttributeEXT float shadow;

// returns distance to closest object in scene (and handles negative objects)
float map(const vec3 p, const float blend)
{
    float d0 = sdf(p, gl_PrimitiveID);
    bool isRootNeg = ssbo.edits[gl_PrimitiveID].negative;

    float sum = isRootNeg ? 0. : 1.0;
    float negsum = !isRootNeg ? 0. : 1.0;

    for(int e = 0; e < ssbo.edits[gl_PrimitiveID].nbNeighbours; e++)
    {
        int id = ssbo.edits[gl_PrimitiveID].neighbours[e];
        float d = sdf(p, id);

        if(!ssbo.edits[id].negative) sum += exp2((d0 - d) * blend);
        else                         negsum += exp2((d0 - d) * blend);
    }

    float p_u = d0 - log2(max(1e-10, sum)) / blend;
    float n_u = d0 - log2(max(1e-10, negsum)) / blend;

    // smooth substraction of (smooth union of positive edits) by (smooth union of negative edits)
    float m = max(p_u, -n_u);
    return m + log2(exp2((p_u - m) * blend) + exp2((-n_u - m) * blend)) / blend;
}

#define SHADOW_SOFTNESS 64
void main()
{
    vec3 p = gl_WorldRayOriginEXT;
    vec3 rd = normalize(gl_WorldRayDirectionEXT);


    float blend = ssbo.edits[gl_PrimitiveID].blendStrength;
    for(int e = 0; e < ssbo.edits[gl_PrimitiveID].nbNeighbours; e++)
    {
        blend = max(blend, ssbo.edits[ssbo.edits[gl_PrimitiveID].neighbours[e]].blendStrength);
    }

    float t = 0.1; p += t * rd;
    shadow = 1.;
    for(int i = 0; i < MAX_IT; i++)
    {
        float safeDist = map(p, blend);

        shadow = min(shadow, SHADOW_SOFTNESS * safeDist / t);

        if(t + safeDist > gl_RayTmaxEXT)
        {
            reportIntersectionEXT(gl_RayTmaxEXT - 0.1, 0U);
            return;
        }

        if(safeDist <= gl_RayTminEXT)
        {
            shadow = 0.;
            reportIntersectionEXT(t, 0U);
            return;
        }

        p += rd * safeDist;
        t += safeDist;
    }
    reportIntersectionEXT(gl_RayTmaxEXT - 0.1, 0U);
}