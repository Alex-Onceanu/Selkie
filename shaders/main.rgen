#version 460
#extension GL_EXT_ray_tracing : require

#include "util.glsl"

layout(push_constant) uniform PushConstants {
    float time;
    uint accumulationFrame;
};

layout(location = 0) rayPayloadEXT payload_t payload;

layout(set = 0, binding = 0) uniform accelerationStructureEXT bvh;
layout(set = 0, binding = 1, rgba32f) uniform image2D image;

uint pcgHash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float stepRand(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) * (1.0 / 4294967296.0);
}

void main()
{
    uint pixelIndex = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
    uint baseSeed = pcgHash(pixelIndex ^ pcgHash(accumulationFrame));

    vec3 cameraPos = vec3(0.0, 2.0, 10.0);

    const int NB_RAYS = 50;
    vec3 totalColor = vec3(0.0);
    
    for (int i = 0; i < NB_RAYS; ++i) {
        uint state = pcgHash(baseSeed ^ uint(i));

        vec2 jitter = vec2(stepRand(state), stepRand(state)) - 0.5;
        vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5 + jitter) / vec2(gl_LaunchSizeEXT.xy);
        
        uv = 2.0 * uv - 1.0;
        uv.x *= float(gl_LaunchSizeEXT.x) / float(gl_LaunchSizeEXT.y);
        uv.y = -uv.y;

        vec3 rayDir = vec3(uv.x, uv.y, -2.0 / tan(0.5 * FOV));

        payload.hitColor = vec3(0.0);
        payload.lifetime = 0;
        payload.energy = 0.0;
        
        payload.seed = vec3(
            stepRand(state),
            stepRand(state),
            stepRand(state)
        ) * 1000.0;

        traceRayEXT(bvh, gl_RayFlagsOpaqueEXT, 0xFF, 0, 1, 0, cameraPos, T_MIN, rayDir, T_MAX, 0);
        
        totalColor += payload.hitColor * payload.energy;
    }
    
    totalColor /= float(NB_RAYS);

    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    
    if (accumulationFrame > 0) {
        vec3 previousColor = imageLoad(image, pixel).rgb;
        totalColor = mix(previousColor, totalColor, 1.0 / float(accumulationFrame + 1));
    }

    imageStore(image, pixel, vec4(totalColor, 1.0));
}