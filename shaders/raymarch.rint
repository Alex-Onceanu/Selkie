#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_debug_printf : enable

#include "constants.glsl"
#include "ssbo.glsl"
#include "sdfs.glsl"

hitAttributeEXT vec3 normal;

// returns distance to the closest object in the scene
// computes n-ary exponential smooth minimum
float map(const vec3 p)
{
    
    float firstDist = sdf(p, gl_PrimitiveID);
    if(ssbo.edits[gl_PrimitiveID].nbNeighbours == 0) return firstDist;

    float sum = exp2(-firstDist * BLEND_STRENGTH);
    for(int e = 0; e < ssbo.edits[gl_PrimitiveID].nbNeighbours; e++)
    {
        edit_t ee = ssbo.edits[ssbo.edits[gl_PrimitiveID].neighbours[e]];
        sum += exp2(-sdf(p, ssbo.edits[gl_PrimitiveID].neighbours[e]) * BLEND_STRENGTH);
    }
    
    return -log2(sum) / BLEND_STRENGTH;
}

// central differences
vec3 computeNormal(const vec3 p)
{
    const float eps = 1e-4;
    const vec2 h = vec2(eps,0);
    return normalize( vec3(map(p+h.xyy) - map(p-h.xyy),
                           map(p+h.yxy) - map(p-h.yxy),
                           map(p+h.yyx) - map(p-h.yyx) ) );
}

void main()
{
    vec3 p = gl_WorldRayOriginEXT;
    vec3 rd = normalize(gl_WorldRayDirectionEXT);
    // debugPrintfEXT("Type = %d, Dims = %f %f %f, pos = %f %f %f", ssbo.edits[gl_PrimitiveID].type, ssbo.edits[gl_PrimitiveID].dimensions.x, ssbo.edits[gl_PrimitiveID].dimensions.y, ssbo.edits[gl_PrimitiveID].dimensions.z, getPos(gl_PrimitiveID).x, getPos(gl_PrimitiveID).y, getPos(gl_PrimitiveID).z);
    // debugPrintfEXT("l1 = %f %f %f %f, l3 = %f %f %f %f", ssbo.edits[0].transform_l1.x, ssbo.edits[0].transform_l1.y, ssbo.edits[0].transform_l1.z, ssbo.edits[0].transform_l1.w, ssbo.edits[0].transform_l3.x, ssbo.edits[0].transform_l3.y, ssbo.edits[0].transform_l3.z, ssbo.edits[0].transform_l3.w);

    float t = 0.;
    for(int i = 0; i < MAX_IT; i++)
    {
        float safeDist = map(p);

        if(t + safeDist > gl_RayTmaxEXT)
        {
            // reportIntersectionEXT(1., 129U);
            return;
        }

        if(safeDist <= gl_RayTminEXT)
        {
            normal = computeNormal(p);
            reportIntersectionEXT(t, 0U);
            return;
        }

        p += rd * safeDist;
        t += safeDist;
    }
}